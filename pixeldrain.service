[Unit]
Description=Pixeldrain RPi Web Uploader Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/media/usb/apps/pi5drain
ExecStart=python web_app.py --port 5000 --folder /media/usb/www/konica/
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
